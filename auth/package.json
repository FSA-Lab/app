{
  "name": "auth",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "start": "func start",
    "test": "vitest run src",
    "test:typecheck": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --types node,vitest --esModuleInterop --skipLibCheck src/index.test.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "better-auth": "^1.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
